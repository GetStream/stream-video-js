{
  "name": "@stream-io/video-react-sdk",
  "version": "2.0.0-beta.4",
  "main": "./dist/index.cjs.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "import": "./dist/esm/embedded.js",
      "require": "./dist/embedded.cjs.js"
    },
    "./dist/css/*": "./dist/css/*"
  },
  "license": "See license in LICENSE",
  "scripts": {
    "clean": "rimraf dist",
    "start": "concurrently -k -n js,css \"rollup -c -w\" \"yarn start:css\"",
    "build": "rimraf dist && yarn build-translations && NODE_ENV=production rollup -c && yarn build:css",
    "build:css": "sass --no-charset --embed-sources src/styling/index.scss:dist/css/styles.css src/styling/embedded.scss:dist/css/embedded.css",
    "start:css": "yarn build:css --load-path=src --watch",
    "build-translations": "node scripts/generate-i18n-keys.mts && yarn run -T prettier --write --log-level warn src/i18n/keys.ts",
    "validate-translations": "yarn build-translations && git diff --exit-code -- src/i18n/keys.ts src/i18n/__tests__/catalog.fixture.json",
    "i18n:export": "node scripts/generate-i18n-keys.mts --json en.json",
    "test": "vitest",
    "test-ci": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GetStream/stream-video-js.git",
    "directory": "packages/react-sdk"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "assets",
    "index.ts",
    "embedded.ts",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/esm/index.js",
    "./dist/esm/embedded.js",
    "./dist/index.cjs.js",
    "./dist/embedded.cjs.js"
  ],
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@stream-io/i18n": "^1.1.0",
    "@stream-io/video-client": "workspace:*",
    "@stream-io/video-filters-web": "workspace:*",
    "@stream-io/video-react-bindings": "workspace:*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stream-io/audio-filters-web": "workspace:^",
    "@stream-io/typescript-config": "workspace:^",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "concurrently": "^9.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.8",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
