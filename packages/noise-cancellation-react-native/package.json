{
  "name": "@stream-io/noise-cancellation-react-native",
  "version": "1.0.0-beta.0",
  "description": "Noise cancellation for the Stream React Native Video SDK",
  "main": "dist/commonjs/index.js",
  "module": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "dist",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "rimraf android/build && rimraf dist",
    "build": "yarn clean && bob build",
    "test": "jest --coverage && yarn test:types",
    "test-ci": "yarn test",
    "test:types": "tsc -p tsconfig.spec.json"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GetStream/stream-video-js.git",
    "directory": "packages/noise-cancellation-react-native"
  },
  "author": "https://getstream.io <support@getstream.io> (https://github.com/GetStream)",
  "license": "See license in LICENSE",
  "bugs": {
    "url": "https://github.com/GetStream/stream-video-js/issues"
  },
  "homepage": "https://github.com/GetStream/stream-video-js#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@stream-io/react-native-webrtc": "145.3.1",
    "@stream-io/typescript-config": "workspace:^",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.5",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@stream-io/react-native-webrtc": "^145.3.1",
    "react-native": ">=0.79.0"
  },
  "codegenConfig": {
    "name": "NoiseCancellationReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.getstream.rn.noisecancellation"
    },
    "ios": {
      "modulesProvider": {
        "NoiseCancellationReactNative": "NoiseCancellationReactNative"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
