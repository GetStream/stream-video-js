skip_docs
require 'net/http'
metro_port = 8081
build_dir = 'dist'
bundle_id = 'io.getstream.rnvideosample'
bundle_id_broadcast = 'io.getstream.rnvideosample.Broadcast-Extension'
provisioning_profile_prefix = 'match AppStore '
android_package_name = 'io.getstream.rnvideosample'
@force_check = false
@impact = nil

private_lane :latest_googleplay_version_code do |options|
  tracks = ["internal", "alpha", "beta", "production"]
  version_codes = []
  tracks.each do |track|
    vc = google_play_track_version_codes(
      package_name: android_package_name,
      json_key: ENV.fetch('RN_DOGFOOD_ANDROID_DEPLOY_SERVICE_ACCOUNT', nil),
      track: track
    )
  rescue StandardError
    puts("No google play release found for track: #{track}")
  else
    version_codes.concat(vc)
  end
  version_codes.max
end

private_lane :latest_appstore_version_code do |options|
  livestates = [true, false]
  version_codes = []
  livestates.each do |livestate|
    vc = app_store_build_number(
      live: livestate,
      app_identifier: bundle_id
    )
  rescue StandardError
    puts("No app store build found for liveState: #{livestate} bundle_id: #{bundle_id}")
  else
    version_codes.append(vc)
  end
  version_codes.max
end

before_all do
  @impact = impact_analysis
  if is_ci
    setup_ci
    ENV['FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT'] = '180'
  end
end

desc 'Installs all Certs and Profiles necessary for appstore'
lane :match_appstore do
  match(
    type: 'appstore',
    app_identifier: [bundle_id, bundle_id_broadcast],
    readonly: is_ci
  )
end

lane :rubocop do
  sh('bundle exec rubocop')
end

lane :stop_metro do
  sh("lsof -t -i:#{metro_port} | xargs kill -s INT || true")
end

lane :load_package do
  load_json(json_path: 'package.json')
end

lane :pod_install do
  Dir.chdir('../ios') do
    sh('bundle exec pod install')
  rescue StandardError # Due this error https://github.com/facebook/react-native/issues/36945#issuecomment-1556230597
    retry_count = 0
    success = false
    until success
      begin
        sh('bundle exec pod update hermes-engine --no-repo-update')
        success = true
      rescue StandardError => e
        retry_count += 1
        UI.user_error!(e) if retry_count > 2
      end
    end
  end
end

lane :bump_ios_version_number do
  increment_version_number(
    version_number: load_package['version'],
    xcodeproj: 'ios/StreamReactNativeVideoSDKSample.xcodeproj'
  )

  current_build_number = latest_appstore_version_code

  puts("Current build number: #{current_build_number}")

  increment_build_number(
    build_number: current_build_number + 1,
    xcodeproj: 'ios/StreamReactNativeVideoSDKSample.xcodeproj'
  )
end

lane :build_ios do
  app_store_connect_api_key

  ENV['NODE_ENV'] = 'production'

  bump_ios_version_number if is_ci

  match_appstore

  gym(
    workspace: 'ios/StreamReactNativeVideoSDKSample.xcworkspace',
    scheme: 'StreamReactNativeVideoSDKSample',
    export_method: 'app-store',
    silent: true,
    clean: true,
    export_options: {
      provisioningProfiles: {
        bundle_id => provisioning_profile_prefix + bundle_id,
        bundle_id_broadcast => provisioning_profile_prefix + bundle_id_broadcast
      }
    },
    include_symbols: true,
    output_directory: build_dir
  )

  Dir.chdir('..') do
    sh("mkdir -p #{build_dir} && mv -f #{lane_context[SharedValues::IPA_OUTPUT_PATH]} #{build_dir}/app.ipa")
  end
end

def extract_iphone_name_and_udid(simulator_line)
  iphone_name = nil
  iphone_udid = nil

  line_without_shutdown = simulator_line.gsub(' (Shutdown)', '').strip

  last_paren_index = line_without_shutdown.rindex('(') # Find the index of the *last* '('

  if last_paren_index
    iphone_name = line_without_shutdown[0...last_paren_index].strip # Full name is before the last '('

    udid_part = line_without_shutdown[last_paren_index..-1]
    # Simpler regex for UDID: just hex chars and hyphens inside parentheses
    udid_match = udid_part.match(/\(([0-9A-F-]+)\)/i)
    if udid_match
      iphone_udid = udid_match[1].strip
    end
  end

  return { name: iphone_name, udid: iphone_udid }
end

def first_iphone_udid
  devices_output = sh(command: 'xcrun simctl list devices | tac', log: false)
  iphone_udid = nil

  devices_output.lines.each do |line|
    next unless line.include?('iPhone') && !line.include?('--') # Check for "iPhone" and not a header line

    iphone_info = extract_iphone_name_and_udid(line)
    # udid_match = line.match(/\(([0-9A-F-]+)\)/) # Regex to extract UDID within parentheses
    next unless iphone_info[:udid]

    iphone_udid = iphone_info[:udid]
    puts("Found iPhone: #{iphone_info}}")
    prepare_simulator(device: iphone_info[:name])
    break # Stop after finding the first iPhone
  end

  if iphone_udid.nil?
    puts("No iPhone simulator found.")
  end

  return iphone_udid # Return the UDID, or nil if not found
end

lane :deploy_ios do
  upload_to_testflight(
    api_key: app_store_connect_api_key,
    ipa: "#{build_dir}/app.ipa",
    groups: ['Dev Testers', 'Stream Testers'],
    changelog: 'Lots of amazing new features to test out!',
    reject_build_waiting_for_review: true,
    distribute_external: true,
    skip_waiting_for_build_processing: false
  )
rescue StandardError => e
  UI.user_error!(e) unless e.message.include?('Another build is in review')

  UI.important('Another build is already in beta review. Skipping beta review submission')
end

lane :bump_android_version_number_play_store do
  latest_app_distribution_version_code = latest_googleplay_version_code

  increment_version_code(
    gradle_file_path: 'android/app/build.gradle',
    version_code: latest_app_distribution_version_code + 1
  )

  increment_version_name(
    gradle_file_path: 'android/app/build.gradle',
    version_name: load_package['version']
  )
end

lane :build_android_play_store do
  ENV['NODE_ENV'] = 'production'

  bump_android_version_number_play_store if is_ci

  gradle(
    project_dir: 'android',
    print_command: false,
    tasks: ["clean", "assembleRelease", "bundleRelease"],
    properties: {
      "android.injected.signing.store.file" => ENV.fetch('RN_DOGFOOD_ANDROID_KEYSTORE', nil),
      "android.injected.signing.store.password" => ENV.fetch('RN_DOGFOOD_ANDROID_KEYSTORE_PASSWORD', nil),
      "android.injected.signing.key.alias" => ENV.fetch('RN_DOGFOOD_ANDROID_KEYSTORE_ALIAS', nil),
      "android.injected.signing.key.password" => ENV.fetch('RN_DOGFOOD_ANDROID_KEYSTORE_PASSWORD', nil)
    }
  )

  Dir.chdir('..') do
    sh("mkdir -p #{build_dir} && mv -f #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]} #{build_dir}/app.aab && mv -f #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]} #{build_dir}/app.apk")
  end
end

lane :deploy_android_play_store do
  supply(
    track: "internal",
    package_name: android_package_name,
    json_key: ENV.fetch('RN_DOGFOOD_ANDROID_DEPLOY_SERVICE_ACCOUNT', nil),
    aab: "#{build_dir}/app.aab"
  )
end

#######################
###### E2E lanes ######
#######################

# The Detox suite drives sample-apps/react-native/e2e-test-app (see its e2e/README.md), a port of the
# Android Video SDK's e2e suite. stream-video-buddy plays the other participants. The e2e app has no
# Gemfile of its own: its lanes live here and run with this bundle.

e2e_app_path = File.absolute_path('../../e2e-test-app')
video_buddy_port = ENV['VIDEO_BUDDY_PORT'] || '5678'

desc 'Installs stream-video-buddy and the browser it drives'
lane :install_video_buddy do
  playwright_version = '1.52.0'
  # The browser build has to match the playwright version stream-video-buddy runs.
  sh("npx -y playwright@#{playwright_version} install chromium")

  stream_video_buddy_version = '1.8.0'
  sh("npm list -g stream-video-buddy | grep -q '#{stream_video_buddy_version}' || " \
     "npm install -g 'https://github.com/GetStream/stream-video-buddy##{stream_video_buddy_version}'")
end

lane :start_video_buddy do |options|
  install_video_buddy unless options[:skip_install]
  stop_video_buddy unless is_ci
  Dir.chdir(e2e_app_path) do
    sh("stream-video-buddy server --port #{video_buddy_port} > video-buddy-server.log 2>&1 &")
  end
  wait_for_video_buddy(port: video_buddy_port)
end

lane :stop_video_buddy do
  Net::HTTP.get_response(URI("http://localhost:#{video_buddy_port}/stop"))
rescue StandardError
  nil
end

private_lane :wait_for_video_buddy do |options|
  require 'socket'
  ready = false
  60.times do
    TCPSocket.new('localhost', options[:port].to_i).close
    ready = true
    break
  rescue Errno::ECONNREFUSED
    sleep(1)
  end
  UI.user_error!("stream-video-buddy did not start on port #{options[:port]}") unless ready
end

desc 'Writes `required=true|false` to $GITHUB_OUTPUT, so CI can skip the e2e jobs before building anything'
lane :e2e_check_required do
  required = is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])
  File.write(ENV['GITHUB_OUTPUT'], "required=#{required}\n", mode: 'a') if ENV['GITHUB_OUTPUT']
  required
end

desc 'Installs the e2e app pods with this bundle (the e2e app has no Gemfile of its own)'
lane :e2e_pod_install do
  Dir.chdir(e2e_app_path) do
    sh('bundle exec pod install --project-directory=ios')
  end
end

# A freshly booted CI emulator is slow enough for the launcher to hit an ANR ("Quickstep isn't
# responding"). The dialog takes window focus, and Espresso then fails every test waiting for it.
private_lane :prepare_android_emulator do
  sh('adb shell settings put global hide_error_dialogs 1')
  # Gives the post-boot CPU load a minute to settle, dismissing ANR dialogs meanwhile. Capped: the
  # load can stay above the threshold for minutes, and each test dismisses ANR dialogs too.
  wait_android_emu_idle(timeout: 60)
end

desc 'Runs the Detox e2e tests. Options: platform (ios|android), configuration (release|debug), ' \
     'device (android: emu|att), skip_build, test (a test file or -t filter)'
lane :test_e2e do |options|
  next unless is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])

  platform = options[:platform] || 'ios'
  device = platform == 'ios' ? 'sim' : (options[:device] || 'emu')
  detox_config = "#{platform}.#{device}.#{options[:configuration] || 'release'}"

  start_video_buddy
  # An attached emulator is already booted; Detox boots `emu` devices itself.
  prepare_android_emulator if platform == 'android' && device == 'att'

  begin
    Dir.chdir(e2e_app_path) do
      sh("yarn e2e:build -c #{detox_config}") unless options[:skip_build]
      # On CI: retry flaky tests, run the simulator headless, and keep logs + screenshots of failures in ./artifacts.
      ci_flags = is_ci ? '--retries 2 --headless --record-logs failing --take-screenshots failing' : ''
      sh("VIDEO_BUDDY_PORT=#{video_buddy_port} yarn detox test -c #{detox_config} --cleanup #{ci_flags} #{options[:test]}")
    end
  ensure
    stop_video_buddy
  end
end

lane :impact_analysis do
  {
    e2e: {
      sources: [
        'packages/client/',
        'packages/react-bindings/',
        'packages/react-native-sdk/',
        'packages/react-native-callingx/',
        'sample-apps/react-native/e2e-test-app/',
        'sample-apps/react-native/dogfood/fastlane/',
        'package.json',
        'yarn.lock',
        '.github/workflows/react-native-e2e-test.yml'
      ],
      checks: ['Test E2E Result']
    }
  }
end
