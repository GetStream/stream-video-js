{
  "name": "@stream-io/video-react-native-dogfood",
  "version": "6.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios-device": "react-native run-ios --device",
    "start": "react-native start --reset-cache",
    "build": "tsc",
    "test": "jest",
    "test-ci": "jest --ci --runInBand",
    "setup": "yarn && yarn build:react-native:deps && npx pod-install"
  },
  "codegenConfig": {
    "name": "FoldRegionSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "io.getstream.rnvideosample.foldregion"
    },
    "ios": {
      "modulesProvider": {
        "FoldRegion": "RCTFoldRegion",
        "VideoEffectsModule": "VideoEffectsModule"
      }
    }
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@notifee/react-native": "9.1.8",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/push-notification-ios": "^1.12.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@stream-io/noise-cancellation-react-native": "workspace:^",
    "@stream-io/react-native-callingx": "workspace:^",
    "@stream-io/react-native-webrtc": "145.4.1",
    "@stream-io/video-filters-react-native": "workspace:^",
    "@stream-io/video-react-native-sdk": "workspace:^",
    "axios": "^1.20.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-blob-util": "^0.25.1",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-haptic-feedback": "^2.3.4",
    "react-native-image-picker": "^8.3.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-permissions": "^5.6.3",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.16.0",
    "react-native-teleport": "^1.2.2",
    "react-native-toast-message": "^2.5.2",
    "react-native-video": "^6.19.3",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "0.13.0",
    "rxjs": "~7.8.2",
    "stream-chat": "^9.54.0",
    "stream-chat-react-native": "^9.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@react-native/typescript-config": "^0.88.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jest": "^29.7.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true,
      "USE_SYNCHRONIZABLE_FOR_MUTABLES": true,
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  }
}
